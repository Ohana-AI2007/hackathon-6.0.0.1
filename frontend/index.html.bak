<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"><title>EduMind AI</title>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<style>
:root{--bg:#f4f7fc;--card:#fff;--tx:#0f1b3d;--mu:#64708f;--bd:#e4e9f4;--navy:#0a1030;--b:#3b82f6;--c:#22d3ee;--p:#8b5cf6;--g:#34d399;--sh:0 6px 24px rgba(30,50,120,.08);box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root:not([data-theme=light]){}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--bg:#0d1224;--card:#151c36;--tx:#e8ecfa;--mu:#93a0c4;--bd:#243055;--sh:0 6px 24px rgba(0,0,0,.3)}}
:root[data-theme=dark]{--bg:#0d1224;--card:#151c36;--tx:#e8ecfa;--mu:#93a0c4;--bd:#243055}
*{box-sizing:border-box}html,body{height:100%;margin:0}body{background:var(--bg);color:var(--tx);font:15px/1.5 Inter,system-ui,sans-serif}
button{font:inherit;cursor:pointer}.g{background:linear-gradient(135deg,var(--b),var(--p));color:#fff;border:0;border-radius:12px;padding:10px 18px;font-weight:600;box-shadow:0 4px 14px rgba(99,102,241,.35);transition:.2s}.g:hover{transform:translateY(-1px)}
.o{background:transparent;border:1px solid var(--bd);color:var(--tx);border-radius:12px;padding:10px 18px;font-weight:600}
#splash{position:fixed;inset:0;z-index:99;background:radial-gradient(ellipse at 30% 20%,#1b2a7a 0,#070a24 60%);display:flex;flex-direction:column;align-items:center;justify-content:center;color:#fff;transition:opacity .6s;text-align:center;padding:20px}
#splash img{width:min(260px,60vw);border-radius:50%;animation:fl 3s ease-in-out infinite;box-shadow:0 0 60px #7c5cff88}
#splash .bar{width:220px;height:6px;border-radius:9px;background:#ffffff22;margin:28px 0 8px;overflow:hidden}#splash .bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--c),var(--p));animation:ld 2.6s forwards}
@keyframes ld{to{width:100%}}@keyframes fl{50%{transform:translateY(-8px)}}
#app{display:flex;height:100%}
aside{width:250px;background:linear-gradient(180deg,#0a1030,#101a4a);color:#c8d2f5;padding:18px 12px;display:flex;flex-direction:column;gap:4px;flex-shrink:0;overflow:auto}
.brand{display:flex;gap:10px;align-items:center;padding:4px 8px 16px;color:#fff;font-weight:800;font-size:18px}.brand img{width:40px;height:40px;border-radius:50%}
.brand small{display:block;font-weight:400;font-size:11px;color:#8fa0d8}
.nv{display:flex;gap:10px;align-items:center;padding:10px 12px;border-radius:12px;background:none;border:0;color:inherit;text-align:left;width:100%}.nv:hover{background:#ffffff12}.nv.on{background:linear-gradient(90deg,#3b82f6aa,#8b5cf655);color:#fff}
.side-foot{margin-top:auto;font-size:12px;color:#8fa0d8;padding:10px}
.wrap{flex:1;display:flex;flex-direction:column;min-width:0}
header{display:flex;gap:14px;align-items:center;padding:12px 24px;background:var(--card);border-bottom:1px solid var(--bd)}
header input{flex:1;max-width:420px;padding:10px 14px;border-radius:12px;border:1px solid var(--bd);background:var(--bg);color:var(--tx)}
.chip{padding:6px 12px;border-radius:99px;background:var(--bg);border:1px solid var(--bd);font-weight:600;font-size:13px;white-space:nowrap}
.av{width:36px;height:36px;border-radius:50%;background:linear-gradient(135deg,var(--c),var(--p));display:grid;place-items:center;color:#fff;font-weight:700}
header .logo{width:30px;height:30px;border-radius:50%}
main{flex:1;overflow:auto;padding:24px;animation:in .4s}@keyframes in{from{opacity:0;transform:translateY(8px)}}
.hero{border-radius:22px;padding:28px;background:linear-gradient(120deg,#1e3a8a,#6d28d9 60%,#0ea5e9);color:#fff;display:flex;justify-content:space-between;align-items:center;gap:20px;overflow:hidden;position:relative}
.hero h1{margin:0 0 6px;font-size:28px}.hero p{margin:4px 0;opacity:.9}.hero em{font-size:13px;opacity:.8}.hero .art{font-size:76px;filter:drop-shadow(0 8px 20px #0006)}
.grid{display:grid;gap:18px;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));margin-top:20px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:20px;padding:20px;box-shadow:var(--sh)}
.fc .ic{font-size:30px;width:56px;height:56px;border-radius:16px;display:grid;place-items:center;margin-bottom:10px}.fc p{color:var(--mu);margin:6px 0 14px}.fc h3{margin:0}
h2{margin:0 0 14px}.mu{color:var(--mu)}.dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--g);box-shadow:0 0 8px var(--g);margin-right:6px}.dot.off{background:#f87171;box-shadow:none}
.flow{display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-content:center;margin:12px 0}.node{padding:10px 14px;border-radius:14px;background:var(--bg);border:1px solid var(--bd);font-weight:600;font-size:13px;transition:.3s}.node.hl{background:linear-gradient(135deg,var(--b),var(--p));color:#fff;transform:scale(1.07)}.ar{color:var(--mu)}
.brain{background:radial-gradient(circle at 50% 0,#1e2a78,#0a1030);color:#fff;border-radius:22px;padding:22px;margin-top:20px}.brain .node{background:#ffffff14;border-color:#ffffff22;color:#fff}
textarea,.in{width:100%;padding:12px;border-radius:12px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);font:inherit}
.row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}.bar{height:10px;background:var(--bg);border-radius:9px;overflow:hidden}.bar i{display:block;height:100%;border-radius:9px;background:linear-gradient(90deg,var(--c),var(--p));transition:width 1s}
.stat b{font-size:26px;display:block}.res{margin-top:16px;padding:16px;border-radius:14px;background:var(--bg);border-left:4px solid var(--p);white-space:pre-wrap}
.err{border-left-color:#f87171}.spin{width:18px;height:18px;border:3px solid var(--bd);border-top-color:var(--p);border-radius:50%;animation:sp .8s linear infinite;display:inline-block;vertical-align:middle;margin-right:8px}@keyframes sp{to{transform:rotate(360deg)}}
.drop{border:2px dashed var(--bd);border-radius:16px;padding:26px;text-align:center;color:var(--mu);margin-bottom:12px}
.set{display:flex;justify-content:space-between;align-items:center;padding:10px 0;border-bottom:1px solid var(--bd);gap:10px}.set select,.set input[type=number]{padding:6px;border-radius:8px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);width:90px}
.timer{font-size:46px;font-weight:800;font-variant-numeric:tabular-nums;background:linear-gradient(90deg,var(--b),var(--p));-webkit-background-clip:text;color:transparent}
#modal{position:fixed;inset:0;z-index:50;background:rgba(5,8,25,.6);backdrop-filter:blur(6px);display:none;align-items:center;justify-content:center;padding:16px}
#modal.show{display:flex}#modal .box{background:linear-gradient(180deg,#121a45,#0a1030);color:#fff;border-radius:26px;padding:28px;max-width:400px;width:100%;text-align:center;border:1px solid #ffffff22;box-shadow:0 20px 80px #6d28d988;animation:pop .35s}
@keyframes pop{from{transform:scale(.9);opacity:0}}#modal img{width:76px;border-radius:50%}#modal .tg{background:linear-gradient(90deg,var(--c),var(--p));-webkit-background-clip:text;color:transparent;font-weight:700;font-size:13px}
#modal h2{margin:10px 0}#modal .box button{display:block;width:100%;margin-top:10px}#modal .o{color:#fff;border-color:#ffffff33}
@media(max-width:800px){aside{width:64px}aside .nv span,.brand div,.side-foot{display:none}main{padding:14px}.hero .art{display:none}header input{display:none}header{padding:10px 14px}}
</style></head><body>
<div id="splash"><img class="L" alt="ONA"><h2 style="margin:18px 0 4px;letter-spacing:2px">Ohana • Nova • Apex</h2><div style="opacity:.8;font-style:italic">Together We Build a Better Tomorrow</div><div class="bar"><i></i></div><small>Loading…</small></div>
<div id="app" style="display:none"><aside id="nav"></aside><div class="wrap"><header><input placeholder="Search anything..."><span style="flex:1"></span><span class="chip" id="tchip">⏱ Idle</span><span title="Notifications" style="font-size:20px">🔔</span><div class="av">S</div><b class="nm">Shivani Yadav</b><img class="L logo" alt="ONA"></header><main id="main"></main></div></div>
<div id="modal"></div>
<script>
const LOGO='data:image/jpeg;base64,',API_BASE='/api',$=s=>document.querySelector(s);
document.querySelectorAll('.L').forEach(i=>i.src=LOGO);
const NAV=[['home','🏠','Home'],['tutor','🤖','AI Tutor'],['video','🎥','Video Learning'],['pdf','📚','PDF Learning'],['blog','✍️','Blog / Content'],['orch','🧠','AI Orchestrator'],['prog','📊','My Progress'],['well','💧','Focus & Wellness'],['set','⚙️','Settings']];
const S={page:'home',secs:0,active:false,paused:false,acc:{b:0,w:0,e:0},water:4,breaks:2,eye:3,videos:12,pdfs:7,qs:46,speed:1,
cfg:{b:60,w:45,e:20,bd:5,tb:1,tw:1,te:1,tm:1},modal:null,brk:0};
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
// ---- API gateway (FastAPI). Falls back to demo data when backend isn't reachable.
async function api(path,body){try{const c=new AbortController();setTimeout(()=>c.abort(),4000);
 const r=await fetch(API_BASE+path,{method:body?'POST':'GET',headers:{'Content-Type':'application/json'},body:body?JSON.stringify(body):undefined,signal:c.signal});
 if(!r.ok)throw new Error(r.status);return{demo:false,data:await r.json()}}catch(e){await sleep(1100);return{demo:true,data:mock(path,body)}}}
function mock(p,b){const t=(b&&b.input)||'';
 if(p=='/agents/status')return{video:true,pdf:true,blog:true};if(p=='/agents/config')return{};
 if(p=='/video')return'📝 Summary: The lecture introduces core ideas of the topic with worked examples.\n\n🔑 Key points:\n• Definition and intuition\n• Common pitfalls\n• Practice strategy\n\n❓ Q&A: Ask follow-up questions about any timestamp.';
 if(p=='/pdf')return'📄 Answer (grounded in your document):\nThe document explains the concept in section 2, with supporting definitions on page 4.\n\n🔑 Key points:\n• Main idea\n• Supporting evidence\n• Takeaways';
 if(p=='/blog')return'✍️ Draft blog: "'+t+'"\n\nIntro, key concepts, real-world examples and a short quiz — ready to edit.\n\n🖼 Suggested images: 3 illustration links generated.';
 if(p=='/orchestrate'){const a=route(t);return{agent:a,text:'Result returned by the '+a+' agent for: "'+t+'"'}}
 return{}}
function route(t){t=t.toLowerCase();return /video|lecture|youtube|watch/.test(t)?'Video':/pdf|document|file|upload/.test(t)?'PDF':/blog|write|create|content|article/.test(t)?'Blog':'Tutor'}
// ---- Pages
const fc=(ic,col,t,d,b,p)=>`<div class="card fc"><div class="ic" style="background:${col}22">${ic}</div><h3>${t}</h3><p>${d}</p><button class="g" onclick="go('${p}')">${b}</button></div>`;
const agentRows=(s={video:1,pdf:1,blog:1})=>[['Video',s.video],['PDF',s.pdf],['Blog',s.blog]].map(a=>`<div><span class="dot ${a[1]?'':'off'}"></span>${a[0]} Agent</div>`).join('');
const flow=(h=-1)=>['User Request','Orchestrator','Understand Intent','Select Agent','Video / PDF / Blog Agent','Return Result'].map((n,i)=>`<span class="node ${i==h?'hl':''}" id="f${i}">${n}</span>`).join('<span class="ar">→</span>');
function task(id,ph,btn,ep,extra=''){return `<div class="card"><h2>${id}</h2>${extra}<textarea id="inp" rows="3" placeholder="${ph}"></textarea><div class="row" style="margin-top:10px"><button class="g" onclick="run('${ep}')">${btn}</button></div><div id="out"></div></div>`}
const P={
home:()=>`<div class="hero"><div><h1>Good Morning, Shivani! 👋</h1><p>Your AI-powered personalized learning companion.</p><em>Learn Smarter. Learn Healthier.</em></div><div class="art">🎓📖✨</div></div>
<div class="grid">${fc('🎥','#3b82f6','Video Learning','Learn from videos, generate summaries, key points and Q&A.','Open Video Learning','video')}${fc('📚','#8b5cf6','PDF Learning','Upload PDFs, ask questions and get grounded answers using document knowledge.','Open PDF Learning','pdf')}${fc('✍️','#22d3ee','Blog / Content','Generate educational blogs, notes and supporting content.','Create Content','blog')}${fc('🤖','#34d399','AI Tutor','Ask questions, understand concepts and get personalized explanations.','Ask AI Tutor','tutor')}</div>
<div class="brain"><div class="row" style="justify-content:space-between"><div><h2 style="margin:0">🧠 AI Orchestrator</h2><span style="opacity:.8">Your intelligent learning coordinator.</span></div><div><span class="dot"></span><b>Orchestrator Online</b></div></div><div class="flow">${flow()}</div><div class="row" style="gap:22px;justify-content:center">${agentRows()}</div><div style="text-align:center;margin-top:14px"><button class="g" onclick="go('orch')">Open Orchestrator</button></div></div>
<p class="mu" style="text-align:center;margin-top:18px">Learning + Focus + Wellness = Success.</p>`,
tutor:()=>`<div class="card"><h2>🤖 AI Tutor</h2><p class="mu">Tell me what you want to learn. The Orchestrator picks the right agent for you.</p><textarea id="inp" rows="3" placeholder="e.g. Summarize this lecture video / Explain my PDF / Create a blog on ML"></textarea><div class="row" style="margin-top:10px"><button class="g" onclick="orch()">Ask AI Tutor</button></div><div id="out"></div></div>`,
orch:()=>`<div class="brain" style="margin-top:0"><h2>🧠 AI Orchestrator</h2><span style="opacity:.8">The central brain that routes each request to the right agent.</span><div class="flow" id="oflow">${flow()}</div></div>
<div class="grid"><div class="card"><h2>Try a request</h2><textarea id="inp" rows="3">Summarize this lecture video</textarea><div class="row" style="margin-top:10px"><button class="g" onclick="orch()">Route Request</button></div><div id="out"></div></div>
<div class="card"><h2>Agent Status</h2><div id="ast">${agentRows()}</div><button class="o" style="margin-top:12px" onclick="refresh()">Refresh</button>
<details style="margin-top:14px"><summary class="mu">Developer / admin</summary><pre class="mu" style="font-size:12px;white-space:pre-wrap">VIDEO_AGENT_URL=…\nPDF_AGENT_URL=…\nBLOG_AGENT_URL=…\n\nGET /api/agents/status\nPOST /api/orchestrate\nMode: <span id="mode">checking…</span></pre></details></div></div>`,
prog:()=>{const t=[['Machine Learning',85],['Python',72],['DBMS',58],['Operating Systems',65]];
return `<h2>📊 My Progress</h2><div class="grid"><div class="card stat"><span class="mu">Overall Progress</span><b>70%</b><div class="bar"><i style="width:70%"></i></div></div><div class="card stat"><span class="mu">Study Time</span><b>18h 40m</b></div><div class="card stat"><span class="mu">Videos Watched</span><b>${S.videos}</b></div><div class="card stat"><span class="mu">PDFs Studied</span><b>${S.pdfs}</b></div><div class="card stat"><span class="mu">Questions Asked</span><b>${S.qs}</b></div><div class="card stat"><span class="mu">Quiz Performance</span><b>82%</b></div><div class="card stat"><span class="mu">Learning Streak</span><b>🔥 9 days</b></div></div>
<div class="card" style="margin-top:18px"><h2>Topic Performance</h2>${t.map(x=>`<div style="margin:12px 0"><div class="row" style="justify-content:space-between"><span>${x[0]}</span><b>${x[1]}%</b></div><div class="bar"><i style="width:${x[1]}%"></i></div></div>`).join('')}</div>
<div class="card" style="margin-top:18px;border-color:var(--p)"><h2>🤖 AI Recommendation</h2><p>Your DBMS performance is lower than your other subjects. We recommend revising Normalization before starting the next topic.</p><button class="g" onclick="go('tutor')">Start Recommended Revision</button></div>`},
well:()=>`<h2>💧 Focus & Wellness</h2><div class="grid"><div class="card"><span class="mu">⏱️ Study Timer</span><div class="timer" id="wt">${fmt(S.secs)}</div><div class="mu" id="ws">${S.active?'Session active':'Start Video, PDF or Tutor to begin'}</div></div>
<div class="card stat"><span class="mu">💧 Water</span><b id="ww">${S.water}/6</b><button class="o" onclick="S.water++;render()">+1 glass</button></div><div class="card stat"><span class="mu">☕ Breaks</span><b>${S.breaks}/3</b></div><div class="card stat"><span class="mu">👀 Eye Rest</span><b>${S.eye}</b></div></div>
<div class="card" style="margin-top:18px"><h2>Preview reminders</h2><div class="row"><button class="o" onclick="show('b')">☕ Break</button><button class="o" onclick="show('w')">💧 Water</button><button class="o" onclick="show('e')">👀 Eyes</button><button class="g" onclick="S.speed=S.speed>1?1:60;render()">${S.speed>1?'⏩ Demo speed ON (60×)':'⏩ Demo speed: 60×'}</button></div><p class="mu">Reminders open automatically over your current page while a study session is active.</p></div>`,
set:()=>{const c=S.cfg,sel=(k,o)=>`<select onchange="S.cfg.${k}=+this.value">${o.map(v=>`<option ${c[k]==v?'selected':''}>${v}</option>`)}</select>`,tg=(k,l)=>`<div class="set"><span>${l}</span><input type="checkbox" ${c[k]?'checked':''} onchange="S.cfg.${k}=+this.checked"></div>`;
return `<h2>⚙️ Settings</h2><div class="card"><h3>Wellness</h3><div class="set"><span>Break reminder (min)</span><input type="number" min="1" value="${c.b}" onchange="S.cfg.b=+this.value"></div><div class="set"><span>Water reminder (min)</span><input type="number" min="1" value="${c.w}" onchange="S.cfg.w=+this.value"></div><div class="set"><span>Eye reminder (min)</span><input type="number" min="1" value="${c.e}" onchange="S.cfg.e=+this.value"></div><div class="set"><span>Break duration (min)</span>${sel('bd',[5,10,15])}</div>${tg('tb','Break reminders')}${tg('tw','Water reminders')}${tg('te','Eye reminders')}${tg('tm','Motivational messages')}<p class="mu">Presets: 30 / 45 / 60 min — or type any custom value.</p></div>`}
};
function fmt(s){const h=Math.floor(s/3600),m=Math.floor(s%3600/60);return String(h).padStart(2,'0')+':'+String(m).padStart(2,'0')+':'+String(Math.floor(s%60)).padStart(2,'0')}
function render(){$('#nav').innerHTML=`<div class="brand"><img src="${LOGO}" alt="ONA"><div>EduMind AI<small>Learn Smarter. Learn Healthier.</small></div></div>`+NAV.map(n=>`<button class="nv ${S.page==n[0]?'on':''}" onclick="go('${n[0]}')">${n[1]} <span>${n[2]}</span></button>`).join('')+'<div class="side-foot">ONA · Ohana • Nova • Apex</div>';
 const m=$('#main');m.style.animation='none';m.offsetWidth;m.style.animation='';m.innerHTML=P[S.page]();if(S.page=='orch')refresh()}
function go(p){if(['video','pdf','blog'].includes(p))return openAgent(p);S.page=p;render()}
async function openAgent(k){let u=CFG[k];
 if(!u){try{CFG=await(await fetch(API_BASE+'/agents/config')).json();u=CFG[k]}catch(e){}}
 if(!u){alert('Agent is not configured.');return}
 start();if(!window.open(u,'_blank'))location.href=u}
let CFG={};
function start(){if(!S.active){S.active=true;S.paused=false}}
async function refresh(){const r=await api('/agents/status');const a=$('#ast');if(a){a.innerHTML=agentRows(r.data);$('#mode').textContent=r.demo?'Demo (backend not connected)':'Live'}}
async function run(ep){const v=$('#inp').value.trim(),o=$('#out');if(!v)return;o.innerHTML='<div class="res"><span class="spin"></span>The Orchestrator is working on it…</div>';
 try{const r=await api(ep,{input:v});const d=r.data;S.qs++;o.innerHTML=`<div class="res">${(typeof d=='string'?d:d.text).replace(/</g,'&lt;')}</div>`}catch(e){o.innerHTML='<div class="res err">⚠️ Something went wrong. Please try again.</div>'}}
async function orch(){const v=$('#inp').value.trim(),o=$('#out');if(!v)return;o.innerHTML='<div class="res"><span class="spin"></span>Routing…</div>';
 if($('#oflow'))for(let i=0;i<6;i++){document.querySelectorAll('#oflow .node').forEach((n,j)=>n.classList.toggle('hl',i==j));await sleep(450)}
 const r=await api('/orchestrate',{input:v}),a=String(r.data.agent||'pdf').toLowerCase(),L={video:'Video    `Learning',pdf:'PDF Learning',blog:'Blog / Content'};
 o.innerHTML=`<div class="res">🎯 Orchestrator selected → <b>${L[a]||a}</b></div><button class="g" style="margin-top:10px" onclick="go('${a}')">Open ${L[a]||a} →</button>`}
// ---- Wellness engine
const MSG={b:['☕','TIME TO BREAK','You have been studying for 1 hour.','Give your mind a short rest.',['👀 Rest your eyes','💧 Drink some water','🧘 Stretch your body']],w:['💧','TIME TO DRINK WATER',"You've been studying for a while.",'Take a moment to hydrate and refresh your mind.',[]],e:['👀','EYE REST TIME',"You've been looking at the screen for a while.",'Rest your eyes for a moment.',[]]};
function show(t){S.modal=t;S.paused=true;const m=MSG[t],c=S.cfg;let btn;
 if(t=='b')btn=`<button class="g" onclick="takeBreak()">Take a ${c.bd} Min Break</button><button class="o" onclick="cont()">Continue Studying</button>`;
 if(t=='w')btn=`<button class="g" onclick="S.water++;S.acc.w=0;cont()">💧 I've Had My Water</button><button class="o" onclick="takeBreak()">☕ Take a Break</button><button class="o" onclick="cont()">Continue Studying</button>`;
 if(t=='e')btn=`<button class="g" onclick="S.eye++;S.acc.e=0;cont()">Got It</button><button class="o" onclick="S.acc.e=S.cfg.e*60-300;cont()">Remind Me Later</button>`;
 $('#modal').innerHTML=`<div class="box"><img src="${LOGO}" alt="ONA"><div class="tg">Ohana • Nova • Apex</div><h2>${m[0]} ${m[1]}</h2><p>${m[2]}</p><p>${m[3]}</p>${m[4].map(x=>`<div>${x}</div>`).join('')}${c.tm?'<p style="color:#8fe;font-size:13px">You\'re doing great — keep it up! ✨</p>':''}${btn}</div>`;$('#modal').classList.add('show')}
function cont(){S.modal=null;S.paused=false;if(S.page=='well')render();$('#modal').classList.remove('show')}
function takeBreak(){S.modal='brk';S.brk=S.cfg.bd*60;S.breaks++;S.acc={b:0,w:0,e:0};const el=$('#modal .box');el.innerHTML=`<img src="${LOGO}" alt="ONA"><h2>🧘 Break time</h2><div class="timer" id="bt" style="font-size:54px">${fmt(S.brk).slice(3)}</div><p>Stretch, breathe, look far away.</p><button class="g" onclick="cont()">I'm Back — Resume Studying</button>`}
setInterval(()=>{const c=S.cfg;
 if(S.modal=='brk'){S.brk-=S.speed;const b=$('#bt');if(b)b.textContent=fmt(Math.max(S.brk,0)).slice(3);if(S.brk<=0)cont();return}
 if(!S.active||S.paused||document.hidden&&0)return;
 S.secs+=S.speed;['b','w','e'].forEach(k=>S.acc[k]+=S.speed);
 $('#tchip').textContent='⏱ '+fmt(S.secs);const wt=$('#wt');if(wt)wt.textContent=fmt(S.secs);
 if(c.tb&&S.acc.b>=c.b*60)show('b');else if(c.tw&&S.acc.w>=c.w*60)show('w');else if(c.te&&S.acc.e>=c.e*60)show('e')},1000);
api('/agents/config').then(r=>CFG=r.data||{});
setTimeout(()=>{$('#splash').style.opacity=0;$('#app').style.display='flex';render();setTimeout(()=>$('#splash').remove(),700)},2800);
</script></body></html>